{
  "name": "@cloudglab/zentao-cli",
  "version": "0.1.7",
  "description": "ZenTao CLI rebuilt for ZenTao 18.5 REST v1 API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudglab/zentao-cli.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zentao": "dist/bin/zentao.js",
    "zentao-cli": "dist/bin/zentao.js",
    "zentao-dev": "dist/bin/zentao-dev.js",
    "zentao-pm": "dist/bin/zentao-pm.js",
    "zentao-qa": "dist/bin/zentao-qa.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "MCP_ZENTAO_REBUILD_PLAN.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx src/bin/zentao.ts",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@vitest/coverage-v8": "^4.1.8",
    "lefthook": "^2.1.9",
    "oxlint": "^1.31.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.24.0"
}
